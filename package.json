{
  "name": "@entrolytics/react-sdk",
  "version": "3.0.1",
  "description": "React SDK for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "entrolytics",
    "form-analytics",
    "react",
    "spa",
    "tracking",
    "web-analytics",
    "web-vitals"
  ],
  "homepage": "https://entrolytics.dev",
  "bugs": {
    "url": "https://github.com/entrolytics/react-sdk/issues"
  },
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/entrolytics/react-sdk",
    "directory": "entro-react"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false",
    "check": "tsc --noEmit",
    "dev": "tsdown --watch",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@entrolytics/shared": "^3.1.0",
    "@entrolytics/trpc-client": "^3.0.1",
    "@tanstack/react-query": "^5.105.3",
    "@trpc/client": "^11.23.0",
    "@trpc/react-query": "^11.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "react": "latest",
    "react-dom": "latest",
    "tsdown": "^0.23.5",
    "typescript": "next",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "react": ">=19.3.0",
    "react-dom": ">=19.3.0"
  },
  "peerDependenciesMeta": {
    "web-vitals": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "web-vitals": "^6.2.3"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.17.0"
}
